-- Write your PostgreSQL query statement below

SELECT 
    -- Student's unique ID
    s.student_id,

    -- Student's name
    s.student_name,

    -- Subject name
    sub.subject_name,

    -- Count how many times this student attended this subject's exam
    -- COUNT(column) ignores NULL values
    COUNT(e.subject_name) AS attended_exams

FROM Students s

-- CROSS JOIN creates EVERY possible combination of:
--     Student × Subject
--
-- Example:
-- Students = {Alice, Bob}
-- Subjects = {Math, Science}
--
-- Result:
-- Alice  → Math
-- Alice  → Science
-- Bob    → Math
-- Bob    → Science
--
-- This is important because we need to show even those
-- student-subject combinations where the student attended
-- ZERO exams.
CROSS JOIN Subjects sub

-- Now find the actual exams attended by each student
LEFT JOIN Examinations e

    -- Match the examination with the student
    ON s.student_id = e.student_id

    -- AND make sure the examination is for the
    -- current subject
    AND sub.subject_name = e.subject_name

-- GROUP BY is required because we are using COUNT()
-- We want one result for each:
--     student + subject
GROUP BY 
    s.student_id,
    s.student_name,
    sub.subject_name

-- Sort the final result
-- First by student ID
-- Then alphabetically by subject name
ORDER BY 
    s.student_id,
    sub.subject_name;